---
// No real beta quotes or stats to show yet — using honest, non-numeric
// value props instead of invented testimonials or fake numbers.
// Swap these for real racer/track quotes as soon as they exist.
const points = [
  { icon: '🎥', text: 'Every lap, captured — no more guessing what happened on track.' },
  { icon: '🤝', text: "Built alongside racers and track owners, not just for them." },
  { icon: '🔁', text: 'Data racers actually want to come back and beat.' },
];
---

<section id="social-proof" class="bg-bg px-6 py-16 md:py-20">
  <div class="mx-auto max-w-5xl grid grid-cols-1 gap-8 sm:grid-cols-3">
    {
      points.map((point) => (
        <div class="text-center sm:text-left">
          <span class="text-3xl" aria-hidden="true">
            {point.icon}
          </span>
          <p class="mt-3 text-ink-muted">{point.text}</p>
        </div>
      ))
    }
  </div>
</section>
