---
---

<div id="for-racers" class="bg-bg px-6 md:px-12 py-16 md:py-20">
  <div class="mx-auto max-w-2xl">
    <h2 class="text-2xl md:text-3xl font-heading font-bold text-ink mb-2">
      Join the Racing Revolution
    </h2>
    <p class="text-ink-muted mb-8 md:mb-12">
      Be first to know when G-CAM launches in your area.
    </p>

    <form class="flex flex-col gap-6" method="POST" action="#">
      <div>
        <label for="racer-email" class="block text-sm font-heading font-bold text-ink mb-2">
          Email
        </label>
        <input
          id="racer-email"
          type="email"
          name="email"
          placeholder="you@example.com"
          required
          class="w-full bg-bg-panel border border-ink-muted/30 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30 px-4 py-3 text-ink placeholder:text-ink-muted min-h-11 transition-colors"
        />
      </div>

      <div>
        <label for="racer-location" class="block text-sm font-heading font-bold text-ink mb-2">
          Location / Zip
        </label>
        <input
          id="racer-location"
          type="text"
          name="location"
          placeholder="City, State or Zip"
          required
          class="w-full bg-bg-panel border border-ink-muted/30 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30 px-4 py-3 text-ink placeholder:text-ink-muted min-h-11 transition-colors"
        />
      </div>

      <div>
        <label for="racer-track" class="block text-sm font-heading font-bold text-ink mb-2">
          Home Track <span class="text-ink-muted">(optional)</span>
        </label>
        <input
          id="racer-track"
          type="text"
          name="home_track"
          placeholder="Your favorite track"
          class="w-full bg-bg-panel border border-ink-muted/30 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30 px-4 py-3 text-ink placeholder:text-ink-muted min-h-11 transition-colors"
        />
      </div>

      <button
        type="submit"
        class="bg-accent text-bg font-heading font-bold px-8 py-3 min-h-12 hover:opacity-90 transition-opacity mt-2"
      >
        Notify Me
      </button>
    </form>

    <p class="text-xs text-ink-muted mt-6">
      We'll email you when G-CAM is available. No spam, ever.
    </p>
  </div>
</div>
