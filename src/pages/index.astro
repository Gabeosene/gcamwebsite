---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SocialProof from '../components/SocialProof.astro';
import RacerSignup from '../components/RacerSignup.astro';
import OperatorInterest from '../components/OperatorInterest.astro';
import EarlyResults from '../components/EarlyResults.astro';
import Footer from '../components/Footer.astro';

// Set to true once real beta data exists — see EarlyResults.astro
const SHOW_EARLY_RESULTS = false;
---

<Layout>
  <Hero />
  <HowItWorks />
  <SocialProof />

  <section id="signup" class="bg-bg-panel">
    <div class="mx-auto max-w-5xl grid grid-cols-1 md:grid-cols-2 md:divide-x md:divide-accent/30">
      <RacerSignup />
      <OperatorInterest />
    </div>
  </section>

  {SHOW_EARLY_RESULTS && <EarlyResults />}

  <Footer />
</Layout>
